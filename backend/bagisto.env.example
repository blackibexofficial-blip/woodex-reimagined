# Bagisto / Laravel environment — copy to backend/bagisto/.env on the server and fill in.
# Generate APP_KEY with: php artisan key:generate
APP_NAME="WOODEX"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.woodex.pk
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PK

LOG_CHANNEL=stack
LOG_LEVEL=warning

# MySQL (cPanel → MySQL Databases)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=woodex_bagisto
DB_USERNAME=woodex_bagisto
DB_PASSWORD=change-me

# Shared-hosting-friendly drivers (no redis/supervisor assumed)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

BROADCAST_CONNECTION=log

# Mail (cPanel → Email Accounts / mailboxes, or SMTP relay)
MAIL_MAILER=smtp
MAIL_HOST=mail.woodex.pk
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@woodex.pk
MAIL_FROM_ADDRESS="no-reply@woodex.pk"
MAIL_FROM_NAME="WOODEX"
MAIL_PASSWORD=change-me

# Sanctum — first-party SPA domains allowed to use session cookies (optional; the React
# admin uses Bearer tokens, but set this anyway for future first-party calls)
SANCTUM_STATEFUL_DOMAINS=woodex.pk,www.woodex.pk,admin.woodex.pk
SESSION_SAME_SITE=lax

# ── bagisto-api (REST + GraphQL) ──────────────────────────────────────────
# Values below are written automatically by `php artisan bagisto-api-platform:install`.
# Keep the playground key secret-ish; rotate after initial setup.
STOREFRONT_KEY_PREFIX=storefront_key_
STOREFRONT_PLAYGROUND_KEY=pk_storefront_change_me
STOREFRONT_DEFAULT_RATE_LIMIT=100
STOREFRONT_CACHE_TTL=60
API_PLAYGROUND_AUTO_INJECT_STOREFRONT_KEY=false

# Force HTTPS behind cPanel's LiteSpeed/Apache termination
ASSET_URL=https://admin.woodex.pk
TRUSTED_PROXIES=*
