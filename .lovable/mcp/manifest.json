{
  "version": 1,
  "sdk_version": "3.0.4",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "woodex-reimagined",
      "version": "0.2.0",
      "title": "WOODEX Reimagined"
    },
    "tools": [
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Search the WOODEX furniture catalog by keyword, category, series or max price (PKR).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Keyword to match in name or description."
            },
            "category": {
              "type": "string",
              "description": "Category id, e.g. 'office-chairs'."
            },
            "series": {
              "type": "string",
              "description": "Series id, e.g. 'ek-series'."
            },
            "maxPrice": {
              "type": "number",
              "description": "Maximum price in PKR."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max results (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product details",
        "description": "Get full details, specifications and colors for one product by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Product id."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_categories_and_series",
        "title": "List categories and series",
        "description": "List all product categories and furniture series offered by WOODEX.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_services",
        "title": "List services",
        "description": "List WOODEX services (custom design, B2B fitouts, delivery, etc.) with their process steps.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_blog_posts",
        "title": "List blog posts",
        "description": "List WOODEX blog articles with id, title, excerpt and date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_blog_post",
        "title": "Read blog post",
        "description": "Read the full text of a WOODEX blog article by id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Blog post id."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "seo_audit_page",
        "title": "SEO audit (advisory)",
        "description": "Advisory, read-only SEO audit of a WOODEX page (/, /product/<id>, /blog/<id>, /service/<slug>). Deterministic checks on title, meta description, focus keyphrase usage, body depth and slug hygiene. No external calls; never mutates anything.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Site path, e.g. '/product/ballmer-executive-desk' or '/blog/custom-office-furniture-cost'."
            },
            "focusKeyphrase": {
              "type": "string",
              "minLength": 1,
              "description": "Optional focus keyphrase to check (case-insensitive)."
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "seo_generate_meta",
        "title": "Generate SEO meta (advisory)",
        "description": "Deterministic, advisory title/description suggestions for a WOODEX page. No external AI calls; templates keyed off the focus keyphrase with 60/160-character word-boundary trims. Read-only output for an editor to apply.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 3,
              "description": "Current page title or working topic, e.g. 'Ballmer Executive Desk'."
            },
            "focusKeyphrase": {
              "type": "string",
              "minLength": 2,
              "description": "Focus keyphrase, e.g. 'executive office desk Lahore'."
            },
            "pageType": {
              "type": "string",
              "enum": [
                "home",
                "product",
                "blog",
                "service",
                "category",
                "generic"
              ],
              "description": "Page family; tunes the benefit clause (default generic)."
            },
            "brand": {
              "type": "string",
              "description": "Brand suffix (default WOODEX)."
            }
          },
          "required": [
            "title",
            "focusKeyphrase"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
