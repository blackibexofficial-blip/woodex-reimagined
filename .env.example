# ─── Supabase (optional — enables "Sign in with Supabase" on /admin/login and
#    storefront-to-Supabase writes). Schema + edge functions: backend/supabase/README.md ─
VITE_SUPABASE_PROJECT_ID=your-supabase-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# ─── WOODEX admin / backend integration (added for the admin stack) ─────────
# API adapter mode: demo (localStorage demo DB, default) | static | bagisto
VITE_API_MODE=demo
# Staging experiment only: default 0. Not authentication; use host access controls
# and X-Robots-Tag: noindex, nofollow. Never enable in production without review.
VITE_CMS_STOREFRONT_PREVIEW=0
# Bagisto REST endpoints (used when VITE_API_MODE=bagisto — see docs/07-admin-integration)
VITE_BAGISTO_API_URL=
VITE_BAGISTO_STOREFRONT_KEY=
# DEMO/PRIVATE-PREVIEW ONLY — the admin integration token must stay server-side in production
VITE_BAGISTO_ADMIN_TOKEN=
VITE_BAGISTO_CHANNEL=default
VITE_BAGISTO_LOCALE=en
VITE_BAGISTO_CURRENCY=PKR
# Demo-only /admin login gate (change these for any shared preview!)
VITE_ADMIN_EMAIL=admin@woodex.pk
VITE_ADMIN_PASSWORD=change-me
# Demo-only second seat used to demonstrate QC separation of duties
# (the person who last changed production stages cannot record the pass).
# Defaults to the same password as VITE_ADMIN_PASSWORD.
VITE_ADMIN_QC_EMAIL=qc@woodex.test
VITE_ADMIN_QC_PASSWORD=
# Opt-in (local dev only): print the demo credentials on the /admin Login screen.
# Unset/0 = never printed — shared previews and production builds stay credential-free.
VITE_ADMIN_DEMO_HINT=0

# ─── Analytics (optional — GA4 measurement id; blank = no tracking, no network) ─
VITE_GA4_ID=


# ─── Anti-abuse: Cloudflare Turnstile (optional until provisioned) ─────────
# Public site key baked into the web build. Leave blank for demo/preview — no widget renders.
VITE_TURNSTILE_SITE_KEY=
# EF-side secret (server-side only): supabase secrets set TURNSTILE_SECRET=...
# Both sides are required together. Server-side INTAKE_ABUSE_MODE=strict requires
# the secret and rejects lead limiter failures. Unset or legacy preserves the old
# fail-open behavior when secret/lead limiter is unavailable; an invalid explicit
# mode fails closed. Set policy only after owner approval and staging tests; it is
# an Edge Function environment setting, NOT a VITE_ browser setting. See
# docs/08-master-plan/PHASE1-INTAKE-STRICT-MODE.md
