# Where the storefront looks for the catalogue API.
#
# Same-origin by default — on Hostinger the React build and the Laravel app share a domain,
# so /api/storefront/v1 is correct with nothing set. Point it at staging only when running
# `npm run dev` locally:
#
#   VITE_API_BASE_URL=https://staging.woodex.pk/api/storefront/v1
VITE_API_BASE_URL=/api/storefront/v1

# Force the bundled catalogue snapshot and never call the API. Useful for a design review or
# a build preview with no backend:
#
#   VITE_CATALOG_OFFLINE=1
# VITE_CATALOG_OFFLINE=
