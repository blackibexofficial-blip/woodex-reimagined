# ============================================================================
#  Woodex OS — production environment template
#  Copy to .env  (the deploy.sh script does this for you), then set APP_URL
#  and generate APP_KEY with:  php artisan key:generate
# ============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Woodex OS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Your real public address, with https:// and no trailing slash.
APP_URL=https://www.example.com
APP_TIMEZONE=Asia/Karachi
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# --- Admin panel -------------------------------------------------------------
# Leave ADMIN_DOMAIN empty to serve the panel at /admin on the main domain.
# Set it (e.g. admin.example.com) to isolate the panel on its own hostname.
ADMIN_DOMAIN=
ADMIN_PATH=admin

# The public marketing site's canonical origin — used for canonical tags,
# sitemap entries and absolute links in transactional email.
PUBLIC_SITE_URL=https://www.example.com

# --- Owner account -----------------------------------------------------------
# Used by `php artisan woodex:owner` to create the first account, and by
# `woodex:owner --force` to repair an existing one. Change the password before
# going live. To change it later:
#   php artisan woodex:owner --password='a-long-new-password'
OWNER_NAME="Owner"
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=
ENFORCE_2FA=false

# --- Security headers --------------------------------------------------------
# Empty = the app's strict default (no framing at all).
SECURITY_FRAME_OPTIONS=
SECURITY_PDF_FRAME_ANCESTORS=
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database ----------------------------------------------------------------
# SQLite ships ready to use and populated. To move to MySQL, see DEPLOY.md
# section 7 and set DB_CONNECTION=mysql with the credentials below.
DB_CONNECTION=sqlite
# Leave DB_DATABASE commented out for SQLite: an EMPTY value is not the same as
# no value — Laravel would try to open a file named "" and fail. Only uncomment
# this if you keep the database somewhere other than database/database.sqlite.
# DB_DATABASE=/absolute/path/to/database.sqlite
DB_TIMEZONE=+05:00
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=woodex
# DB_USERNAME=woodex
# DB_PASSWORD=

# --- Legacy interior website import (leave as-is) -----------------------------
LEGACY_DB_DRIVER=mysql
LEGACY_DB_SQLITE_PATH=
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# --- Sessions & cache --------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
# Set to your bare domain (e.g. .example.com or null) to share the session
# between the storefront and an admin subdomain. null = exact host only.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
ASSET_URL=/

# --- Mail --------------------------------------------------------------------
# Defaults to "log" so nothing is sent by accident. Switch MAIL_MAILER to smtp
# and fill in a mailbox before going live, or lead notifications stay in
# storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storefront → CRM lead bridge --------------------------------------------
# Comma-separated origins allowed to POST leads to /api/leads. Add your domain
# so the storefront's own forms (same origin) and any headless frontend work.
PUBLIC_LEADS_ALLOWED_ORIGINS=https://www.example.com
PUBLIC_LEADS_BRIDGE_KEY=

# --- Cloudflare Turnstile (optional anti-spam on public forms) ----------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Telegram notifications (optional) ---------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOW_LEGACY_WEBHOOK=false

# --- WhatsApp Cloud API (optional) -------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0

# --- Google sign-in for the panel (optional) ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SIGN_IN_ENABLED=false
GOOGLE_WORKSPACE_REDIRECT_URI=
GOOGLE_WORKSPACE_SCOPES=

# --- Preview-only flags ------------------------------------------------------
# These exist for the hosted demo. All must stay false/empty in production:
# they inject a credential hint on the sign-in screen and enable synthetic data.
WOODEX_SYNTHETIC_PREVIEW=false
WOODEX_PREVIEW_SHOW_CREDENTIALS=false
WOODEX_PREVIEW_LOGIN_EMAIL=
WOODEX_PREVIEW_LOGIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
